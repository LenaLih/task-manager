{
  "name": "codex-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev-next.mjs",
    "build": "next build && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "node dist-server/index.js",
    "test": "vitest run && node --test scripts/start-production.test.mjs",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.next.json && tsc -b && tsc -p server/tsconfig.json --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "db:migrate": "tsx server/migrate-cli.ts",
    "db:migrate:production": "node dist-server/migrate-cli.js",
    "dev:api:sqlite": "tsx watch server/sqlite-index.ts",
    "start:api:sqlite": "node dist-server/sqlite-index.js",
    "dev:vite": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build:vite": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3000",
    "build:next": "next build",
    "start:next": "next start --hostname 127.0.0.1 --port 3000",
    "test:e2e": "tsx e2e/run.ts",
    "test:e2e:install": "tsx e2e/run.ts --install",
    "start": "node scripts/start-production.mjs",
    "test:production": "node --test scripts/production-smoke.test.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
