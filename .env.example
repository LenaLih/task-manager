# Copy to .env and generate TWO distinct random secrets (at least 32 characters).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Retained only for the explicit SQLite rollback backend.
DATABASE_PATH=./data/tasks.sqlite
# Main API and PostgreSQL migrations. Matches compose.yaml defaults.
DATABASE_URL=postgresql://task_manager:task_manager_local_only@127.0.0.1:5432/task_manager?sslmode=disable
# Local Docker password only; update the URL too if changing this value.
POSTGRES_PASSWORD=task_manager_local_only
# Optional integration tests: must be a separate database ending in _test.
TEST_DATABASE_URL=
PORT=3001
APP_ORIGIN=http://localhost:5173
# Set NODE_ENV=production in the server environment for HTTPS deployment.
# Configure PostgreSQL TLS for the deployment endpoint; sslmode=disable is local only.
